<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor for the Student Portal (Question 3).
    Target: Apache Tomcat 8.5 = Servlet 3.1 / JSP 2.3 (javax.servlet packages).
    All servlet and filter mappings are declared here in one place.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Student Portal</display-name>

    <!-- Folder where Question 2 (PHP) saves uploaded files. FileServlet reads from here.
         Change this if your project is in a different location. Use forward slashes. -->
    <context-param>
        <param-name>uploadDirectory</param-name>
        <param-value>C:/xampp/htdocs/WebTechnology_Assignment2/Question2_PHP/uploads</param-value>
    </context-param>

    <!-- ===== Servlets ===== -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FileServlet</servlet-name>
        <servlet-class>com.studentportal.servlet.FileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FileServlet</servlet-name>
        <url-pattern>/FileServlet</url-pattern>
    </servlet-mapping>

    <!-- ===== Login check for protected pages ===== -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.studentportal.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/students</url-pattern>
        <url-pattern>/FileServlet</url-pattern>
        <url-pattern>/students.jsp</url-pattern>
        <url-pattern>/profile.jsp</url-pattern>
    </filter-mapping>

    <!-- Session expires after 30 minutes of inactivity -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>   <!-- JavaScript cannot read the session cookie -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Friendly error pages instead of Tomcat's default ones -->
    <error-page>
        <error-code>400</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <!-- Default (catch-all) error page for any other error code, e.g. 405.
         Hides Tomcat's built-in page, which shows the server version. -->
    <error-page>
        <location>/error.jsp</location>
    </error-page>

    <!-- Opening http://localhost:8080/StudentPortal/ goes to index.jsp -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
